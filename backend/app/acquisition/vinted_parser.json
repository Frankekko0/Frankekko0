    "vinted.it",
    "vinted.fr",
    "vinted.de",
    "vinted.es",
    "vinted.be",
    "vinted.nl",
    "vinted.lu",
    "vinted.pt",
    "vinted.at",
    "vinted.pl",
    "vinted.cz",
    "vinted.sk",
    "vinted.lt",
    "vinted.co.uk",
    "vinted.com",
