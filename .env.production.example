# FlipFinder in production - copy to .env.production (git-ignored) and fill in.
# Start: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d --build

# Stable address: a domain (or subdomain) pointing to this machine; ports 80 and 443 open.
DOMAIN=flip.example.com

# Secrets: generate each with  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_PASSWORD=

# Backups (pg_dump): directory on this machine, days kept, hour of the daily backup (UTC)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=2

# Optional: AI photo analysis and deal analyst
AI_API_KEY=
