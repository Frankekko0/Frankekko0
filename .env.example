# =============================================================================================
# Vinted FlipFinder - configuration template. Copy to `.env` (Docker Compose, repo root) or to
# `backend/.env` (backend run locally). NEVER commit the real `.env`: it is git-ignored.
# Every value below is optional for local use; empty = feature disabled.
# Production (HTTPS, only you, automatic backups): see deploy/README.md and .env.production.example.
# =============================================================================================

# --- General ----------------------------------------------------------------------------------
# development | production   (production refuses dev secrets and insecure cookies)
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON logs for log shippers; false = human-readable console logs
LOG_JSON=true
# Public URL of the web app (links in notifications, CORS)
PUBLIC_APP_URL=http://localhost:3000

# --- Database / cache -------------------------------------------------------------------------
# Docker Compose builds DATABASE_URL from these (URL-encode special characters in the password)
POSTGRES_USER=flipfinder
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=flipfinder
# Used when the backend runs outside Docker (Compose overrides both with service hostnames)
DATABASE_URL=postgresql+asyncpg://flipfinder:change-me-local-only@localhost:5432/flipfinder
REDIS_URL=redis://localhost:6379/0

# --- Security ---------------------------------------------------------------------------------
# REQUIRED in production: random string of at least 32 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Protects the seller keys stored in the database (see backend/app/core/seller_key.py). Unset: derived
# from JWT_SECRET, so rotating JWT_SECRET would change every key. Set it once and keep it.
SELLER_KEY_SECRET=
ACCESS_TOKEN_TTL_MINUTES=720
# true when served over HTTPS (mandatory in production)
COOKIE_SECURE=false
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=10
# X-Forwarded-For handling: number of proxies you control in front of the API
# (1 = the Next.js proxy only; 2 = nginx/Caddy + Next.js). false = backend exposed directly.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1
# false = only the first account (yours) can be created; set false in production
ALLOW_REGISTRATION=true
# Directory for the error log (warnings and errors, rotated, secrets redacted); empty = off
ERROR_LOG_DIR=

# --- Marketplace data source -----------------------------------------------------------------
# none = only what you capture (browser extension, links, email): nothing is ever simulated
# feed = authorised JSON feed / partner API you have the right to use (see README)
MARKETPLACE_PROVIDER=none
FEED_URL=
FEED_API_KEY=
FEED_REQUESTS_PER_MINUTE=30
# Scanner cadence and batch size
SCAN_INTERVAL_SECONDS=30
SCAN_BATCH_SIZE=500
# Worker processes (0 = one per CPU core, at most 4) and DB connections per worker process
WORKER_PROCESSES=0
WORKER_DB_POOL_SIZE=6
# Opportunity / watchlist alerts only for listings published within this window (hours)
ALERT_MAX_LISTING_AGE_HOURS=72

# --- AI Deal Analyst (optional) ---------------------------------------------------------------
# Without a key the rule-based analyst is used; numbers always come from the statistical engine.
# Provider: anthropic (default) or gemini (Google AI Studio, has a free key; see docs/DEPENDENCIES.md).
# For gemini: AI_PROVIDER=gemini, AI_API_KEY=<AI Studio key>, AI_MODEL=gemini-2.5-flash,
# AI_MODEL_CHEAP=gemini-2.5-flash-lite, all four AI_PRICE_* = 0, AI_VISION_ENABLED=false (free tier data may be
# used by Google; photos stay on your server). Check current model names and limits in AI Studio.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
AI_VISION_ENABLED=true
# Deals at or above this Flip Score get an automatic AI analysis
AI_AUTO_ANALYZE_MIN_FLIP_SCORE=80
# Routing: modello economico per il volume (agente, triage), AI_MODEL dove la posta è alta.
AI_MODEL_CHEAP=claude-haiku-5-5
# Tetti di spesa in USD (giorno UTC e mese). Raggiunto il tetto nessuna chiamata a pagamento parte:
# l'app torna alle regole. Lo 0 spegne le chiamate. Vedi docs/DEPENDENCIES.md.
AI_DAILY_BUDGET_USD=1.00
AI_MONTHLY_BUDGET_USD=20.00
AI_CALL_RESERVE_USD=0.05
# Prezzi per milione di token: SONO ASSUNZIONI, impostali ai prezzi del tuo piano.
AI_PRICE_STRONG_INPUT_PER_MTOK=3
AI_PRICE_STRONG_OUTPUT_PER_MTOK=15
AI_PRICE_CHEAP_INPUT_PER_MTOK=1
AI_PRICE_CHEAP_OUTPUT_PER_MTOK=5
# Dopo questo numero di errori consecutivi il fornitore viene lasciato in pace per AI_BREAKER_COOLDOWN_SECONDS.
AI_BREAKER_FAILURES=5
AI_BREAKER_COOLDOWN_SECONDS=60
# Agente di revisione: passi, costo massimo per esecuzione, avvisi al giorno, opportunità riviste.
AGENT_MAX_STEPS=8
AGENT_MAX_COST_USD=0.10
AGENT_MAX_NOTIFICATIONS_PER_DAY=5
AGENT_REVIEW_LIMIT=12

# --- Notifications (optional; in-app alerts always work) -------------------------------------
# Telegram: create a bot with @BotFather; users enter their chat id in Settings
TELEGRAM_BOT_TOKEN=
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FlipFinder <alerts@example.com>
SMTP_STARTTLS=true
# Web Push (VAPID). Generate a key pair once, see README -> Notifiche
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Discord: no server config needed, users paste a channel webhook URL in Settings

# --- Vinted data acquisition (see docs/ACQUISITION.md) ----------------------------------------
# The browser extension and manual imports always work. These modes are optional.
#
# The server reads no Vinted page by itself (Vinted's terms, in force from 8 Oct 2026, forbid
# automated collection): data come only from the extension on pages you open, links, emails, manual
# imports and authorized feeds. The old VINTED_PUBLIC_FETCH_* settings were removed.
#
# Vinted notification emails ("favourite sold" confirms a sale, "price reduced" a new price),
# read from a mailbox in read-only mode (nothing is marked as read, moved or deleted). Use an
# app password and, ideally, a folder that receives only Vinted emails. Leave empty to upload
# .eml files from Settings -> Data sources instead.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_MINUTES=15
#
# Vinted selectors/labels/patterns, shared with the extension. Point this to a mounted copy of
# backend/app/acquisition/vinted_parser.json to fix the parser without rebuilding anything.
PARSER_CONFIG_PATH=

# --- External price references (optional, see docs/EXTERNAL_PRICES.md) -----------------------
# New prices, second-hand asking prices and concluded sales of each model on other marketplaces
# (eBay, Vestiaire Collective, Depop, Grailed, Subito, Wallapop; never Vinted), found through an
# official search API: Serper.dev (Google results as JSON, no scraping). none = off.
# Never searched while a page is analysed: the worker refreshes a per-model cache in background.
# Cost: 1 query = 1 credit = $0.001 (2,500 free credits at sign-up, no card; then $50 / 50,000,
# valid 6 months). 2 queries per model (+1 for concluded sales when the model was found).
EXTERNAL_SEARCH_PROVIDER=none
# Key from https://serper.dev -> API Key. Never logged.
SERPER_API_KEY=
# Hard caps on queries (counted before every call): per month and per day (UTC)
EXTERNAL_SEARCH_MONTHLY_BUDGET=900
EXTERNAL_SEARCH_DAILY_MAX=60
# A model is searched again after this many days, only if it was seen again meanwhile
EXTERNAL_REFRESH_DAYS=30
# Google country / language of the results (gl / hl)
EXTERNAL_SEARCH_COUNTRY=it
EXTERNAL_SEARCH_LANGUAGE=it
# Third query per model for concluded sales (only when the first two found the model)
EXTERNAL_SEARCH_SOLD_QUERY=true

# ---- Photo copies (tracking page, photo analysis) ------------------------------
# The server never downloads anything from Vinted. The browser extension (if the user switched
# "send photos" on in its options) uploads the photos of the listing page they opened; they are
# validated (real image, size, dimensions) and kept once under their SHA-256. Copies are for internal
# use only: served only to signed-in users, never republished. false: uploads are refused.
IMAGE_ARCHIVE_ENABLED=true
MEDIA_DIR=var/media
IMAGE_ARCHIVE_MAX_BYTES=10485760

# ---- Value of information for photo analysis ------------------------------------
# What one photo analysis is assumed to cost, in euros, when deciding whether it is worth paying for
# (model call plus the wait). An assumption, not a measurement; the AI_*_BUDGET caps still apply.
VISION_VOI_COST_EUR=0.5
